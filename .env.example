# Runtime
NODE_ENV=development
PORT=3000
SITE_URL=https://localhost:3000
TRUST_PROXY=false
# Development generates a persistent self-signed certificate in HTTPS_DEV_CERT_DIR.
# Set both PEM paths to use an existing certificate instead.
HTTPS_KEY_FILE=
HTTPS_CERT_FILE=
HTTPS_DEV_CERT_DIR=./data/tls

# Local persistent embedded MongoDB. Production must use MONGODB_URI.
MONGODB_URI=
MONGODB_DB_NAME=wyre
MONGODB_EMBEDDED=true
MONGODB_DATA_DIR=./data/mongodb
MONGODB_BINARY_DIR=./data/mongodb-binaries

# Generate a unique value; never copy this placeholder into production.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_DAYS=30
OWNER_EMAIL=

# WebAuthn / platform biometrics. Empty values derive from SITE_URL.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
WEBAUTHN_APP_LOCK_MINUTES=15

# Email
EMAIL_TRANSPORT=console
SMTP_FALLBACK_TO_CONSOLE=false
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Wyre <your-address@example.com>
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
DISPOSABLE_EMAIL_DOMAINS=

# Yandex ID OAuth
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# WebRTC TURN
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# AI / voice transcription (OpenAI-compatible endpoint; Groq by default)
GROQ_API_KEY=
# Personal "Wyre AI" assistant chat (needs GROQ_API_KEY)
AI_ASSISTANT_ENABLED=true
AI_TRANSCRIPTION_URL=https://api.groq.com/openai/v1/audio/transcriptions
AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AI_CHAT_URL=https://api.groq.com/openai/v1/chat/completions
AI_CHAT_MODEL=openai/gpt-oss-120b
# AI image generation for the "Wyre AI" chat (Pollinations, free and keyless)
AI_IMAGE_ENABLED=true
AI_IMAGE_URL=https://image.pollinations.ai/prompt

# Private chat attachments
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=51200
PDF_FONT_FILE=

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Firebase Cloud Messaging (background push for the Android app).
# Values come from a Firebase service-account JSON (project_id, client_email,
# private_key). Empty values disable FCM; the web push above keeps working.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
