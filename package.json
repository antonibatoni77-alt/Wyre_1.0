{
  "name": "sandbox",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir ../../dist/client --emptyOutDir",
    "build:server": "esbuild src/server/app.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/app.mjs",
    "build:test": "esbuild scripts/integration-test.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/integration-test.mjs",
    "start": "node dist/server/app.mjs",
    "dev": "tsx watch src/server/app.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "npm run build:test && node dist/integration-test.mjs",
    "reset:accounts": "esbuild scripts/reset-accounts.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/reset-accounts.mjs && node dist/reset-accounts.mjs",
    "grant:role": "esbuild scripts/grant-role.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/grant-role.mjs && node dist/grant-role.mjs",
    "grant:badge": "esbuild scripts/grant-badge.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/grant-badge.mjs && node dist/grant-badge.mjs",
    "desktop:dev": "cd desktop && npm run dev",
    "desktop:start": "cd desktop && npm start",
    "desktop:dist": "cd desktop && npm run dist",
    "android:dist": "cd mobile-android && build.cmd",
    "test": "npm run typecheck && npm run build && npm run test:integration"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tanstack/react-query": "^5.90.21",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "lucide-react": "^0.575.0",
    "mongodb": "^6.18.0",
    "mongodb-memory-server": "^10.2.0",
    "motion": "^12.43.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.4",
    "otplib": "^13.4.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "selfsigned": "^3.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.8",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.3",
    "typescript": "^5.3.3",
    "vite": "^7.3.6"
  }
}
